{
  "name": "@ws/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply web-subscriber-db --local",
    "migrate:remote": "wrangler d1 migrations apply web-subscriber-db --remote",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@ws/shared": "workspace:*",
    "hono": "4.10.6",
    "jose": "6.1.2",
    "ulid": "3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "wrangler": "4.155.0"
  }
}
