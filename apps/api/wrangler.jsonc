{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "web-subscriber",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/worker/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "ws-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "ws-blobs" }],
  "workflows": [{ "name": "ws-setup", "binding": "SETUP_WORKFLOW", "class_name": "SetupWorkflow" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "DEFAULT_TIMEZONE": "Asia/Tokyo",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "REPAIR_AFTER_FAILURES": "2",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_AUTH_BYPASS": "0"
  }
}
