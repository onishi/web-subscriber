{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "web-subscriber",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/worker/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "web-subscriber-db", "database_id": "9df90e71-a98f-43a3-84f1-1a108318e3f3", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "web-subscriber-blobs" }],
  "workflows": [{ "name": "ws-setup", "binding": "SETUP_WORKFLOW", "class_name": "SetupWorkflow" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "DEFAULT_TIMEZONE": "Asia/Tokyo",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "REPAIR_AFTER_FAILURES": "2",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEV_AUTH_BYPASS": "0"
  }
}
