# VPS 上の <APP_DIR>/.env.crawler（scripts/vps/run-crawler.sh が読み込む）
WS_API_BASE=https://web-subscriber.example.workers.dev
# apps/api/scripts/create-worker-token.mjs で発行
WS_WORKER_TOKEN=
WS_WORKER_ID=sakura-vps-1
# User-Agent に載る連絡先URL（クロール対象サイトの管理者向け）
WS_CONTACT_URL=https://example.com/web-subscriber-crawler
# 既定は <APP_DIR>/apps/crawler/data
# WS_DATA_DIR=/home/app/apps/web-subscriber/apps/crawler/data
WS_CONCURRENCY=2
WS_POLL_INTERVAL_MS=10000
# HTTP 応答のディスクキャッシュ（<WS_DATA_DIR>/http-cache。http 方式のみ）。0 で無効
# WS_HTTP_CACHE=1
# 購読元（フィード・一覧ページ）とプローブ：既定 10 分
# WS_HTTP_CACHE_SOURCE_TTL_MS=600000
# item のリンク先（og:image）・robots.txt：既定 24 時間
# WS_HTTP_CACHE_LINK_TTL_MS=86400000
