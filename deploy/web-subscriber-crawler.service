# さくらVPS 用 systemd ユニット（/etc/systemd/system/web-subscriber-crawler.service）
[Unit]
Description=Web Subscriber crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webcrawler
WorkingDirectory=/opt/web-subscriber/apps/crawler
EnvironmentFile=/etc/web-subscriber/crawler.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=10
# 停止時は実行中ジョブの完了を最大60秒待つ
TimeoutStopSec=75
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
