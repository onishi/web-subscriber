# systemd ユーザーユニット（app ユーザーの ~/.config/systemd/user/ に置く）
# pnpm vps:deploy が @APP_DIR@ を置換して配置する。
[Unit]
Description=Web Subscriber crawler

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/scripts/vps/run-crawler.sh
Restart=always
RestartSec=10
# 停止時は実行中ジョブの完了を最大60秒待つ
TimeoutStopSec=75
KillSignal=SIGTERM

[Install]
WantedBy=default.target
